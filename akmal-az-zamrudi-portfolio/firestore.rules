rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication and Identity verification helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() && 
             request.auth.token.email_verified == true && 
             request.auth.token.email == 'azamrudi@gmail.com';
    }

    // Projects Rules allowing public read access, but only authorized admin edits
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    // Publications (NLP/LLM research papers) Rules
    match /publications/{publicationId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    // Journey Milestones Rules
    match /milestones/{milestoneId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }
  }
}
